# Ignore everything, then allow-list what belongs in the repo
*

# Top-level files
!.gitignore
!.yamllint
!*.md
!LICENSE
!*.yaml

# Directories tracked in full
!automation/
!automation/**
!blueprints/
!blueprints/**
# stock Home Assistant blueprints are not ours
blueprints/automation/homeassistant/
blueprints/script/
blueprints/template/
!config/
!config/**
!docs/
!docs/**
!scripts/
!scripts/**
!themes/
!themes/**
!tools/
!tools/**

# Dashboards (the rest of .storage is runtime state)
!.storage/
.storage/*
!.storage/lovelace.lovelace
!.storage/lovelace.home_original
!.storage/lovelace_dashboards
!.storage/lovelace_resources

# Never commit
secrets.yaml
!www/
!www/clip.html
