        {
          "title": "Cars",
          "path": "cars",
          "icon": "mdi:car-electric",
          "type": "sections",
          "max_columns": 3,
          "theme": "home_new",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "KARR",
                  "icon": "mdi:car-electric"
                },
                {
                  "type": "custom:mushroom-template-card",
                  "entity": "sensor.karr_battery",
                  "primary": "Battery {{ states('sensor.karr_battery') | float(0) | round(0) | int }}%",
                  "secondary": "{% set ch = is_state('binary_sensor.karr_charging','on') %}{% if ch %}Charging · {{ states('sensor.karr_charger_power') | float(0) | round(1) }} kW · {% set h = states('sensor.karr_charging_time_remaining') | float(0) %}{{ h | int }}h {{ ((h % 1) * 60) | round(0) | int }}m left{% else %}{{ states('sensor.karr_range_ideal') | float(0) | round(0) | int }} mi · {{ 'Plugged in' if is_state('binary_sensor.karr_plug','on') else 'Unplugged' }}{% endif %}",
                  "icon": "{{ 'mdi:battery-charging' if is_state('binary_sensor.karr_charging','on') else 'mdi:battery' }}",
                  "icon_color": "{% if is_state('binary_sensor.karr_charging','on') %}amber{% elif is_state('binary_sensor.karr_plug','off') and is_state('device_tracker.karr','home') and states('sensor.karr_battery') | float(100) < 50 %}red{% else %}green{% endif %}",
                  "tap_action": {
                    "action": "more-info"
                  },
                  "fill_container": true,
                  "grid_options": {
                    "columns": 6
                  }
                },
                {
                  "type": "tile",
                  "entity": "number.karr_charge_limit",
                  "name": "Charge limit",
                  "icon": "mdi:battery-lock",
                  "color": "green",
                  "features": [
                    {
                      "type": "numeric-input",
                      "style": "buttons"
                    }
                  ],
                  "grid_options": {
                    "columns": 6
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "entity": "sensor.karr_state",
                  "primary": "{{ states('sensor.karr_state') }}",
                  "secondary": "{{ 'Tap icon to wake' if states('sensor.karr_state') in ['Asleep','Offline'] else '' }}",
                  "icon": "{{ 'mdi:sleep' if states('sensor.karr_state') in ['Asleep','Offline'] else 'mdi:car-connected' }}",
                  "icon_color": "{{ 'grey' if states('sensor.karr_state') in ['Asleep','Offline'] else 'blue' }}",
                  "tap_action": {
                    "action": "more-info"
                  },
                  "icon_tap_action": {
                    "action": "perform-action",
                    "perform_action": "button.press",
                    "target": {
                      "entity_id": "button.karr_wake_up"
                    }
                  },
                  "fill_container": true,
                  "grid_options": {
                    "columns": 6
                  }
                },
                {
                  "type": "tile",
                  "entity": "climate.karr_hvac_climate_system",
                  "name": "Climate",
                  "color": "cyan",
                  "tap_action": {
                    "action": "toggle"
                  },
                  "grid_options": {
                    "columns": 6
                  }
                },
                {
                  "type": "tile",
                  "entity": "lock.karr_doors",
                  "name": "Doors",
                  "color": "green",
                  "features": [
                    {
                      "type": "lock-commands"
                    }
                  ],
                  "grid_options": {
                    "columns": 6
                  }
                },
