                  "heading": "Climate",
                  "icon": "mdi:thermostat",
                  "tap_action": {
                    "action": "navigate",
                    "navigation_path": "/lovelace/climate"
                  }
                },
                {
                  "type": "tile",
                  "entity": "climate.upstairs",
                  "name": "Upstairs",
