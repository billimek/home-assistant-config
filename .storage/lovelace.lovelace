{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.lovelace",
  "data": {
    "config": {
      "views": [
        {
          "title": "Home",
          "path": "home",
          "icon": "mdi:home",
          "type": "sections",
          "max_columns": 2,
          "theme": "home_new",
          "header": {
            "layout": "start",
            "card": {
              "type": "custom:button-card",
              "show_icon": false,
              "show_name": false,
              "show_state": false,
              "show_label": false,
              "tap_action": {
                "action": "none"
              },
              "triggers_update": [
                "cover.jeff_garage_door",
                "cover.jen_garage_door",
                "alarm_control_panel.ser2sock_10000_alarm_panel",
                "sensor.alarm_zones_active",
                "input_boolean.guest_mode"
              ],
              "custom_fields": {
                "date": "[[[ return new Date().toLocaleDateString([], {weekday: 'long', month: 'long', day: 'numeric'}); ]]]",
                "greeting": "[[[ const h = new Date().getHours(); return 'Good ' + (h < 12 ? 'morning' : h < 18 ? 'afternoon' : 'evening') + ', Jeff'; ]]]",
                "status": "[[[ const g = ['cover.jeff_garage_door','cover.jen_garage_door'].filter(e => states[e] && states[e].state !== 'closed'); const z = states['sensor.alarm_zones_active']; const zn = z ? Number(z.attributes.active || 0) : 0; const a = (states['alarm_control_panel.ser2sock_10000_alarm_panel'] || {state: 'unknown'}).state.replace(/_/g, ' '); const dot = '<span style=\"display:inline-block;width:8px;height:8px;border-radius:4px;background:currentColor;margin-right:10px;vertical-align:middle\"></span>'; return dot + (g.length ? 'Garage open: ' + g.map(e => states[e].attributes.friendly_name).join(', ') : zn > 0 ? z.state : 'All quiet: garages closed, alarm ' + a) + (states['input_boolean.guest_mode'] && states['input_boolean.guest_mode'].state === 'on' ? ' · Guest mode on' : ''); ]]]"
              },
              "styles": {
                "card": [
                  {
                    "background": "transparent"
                  },
                  {
                    "border": "none"
                  },
                  {
                    "box-shadow": "none"
                  },
                  {
                    "padding": "4px 0 0 0"
                  }
                ],
                "grid": [
                  {
                    "grid-template-areas": "\"date\" \"greeting\" \"status\""
                  },
                  {
                    "grid-template-columns": "1fr"
                  },
                  {
                    "row-gap": "4px"
                  }
                ],
                "custom_fields": {
                  "date": [
                    {
                      "justify-self": "start"
                    },
                    {
                      "font-size": "14px"
                    },
                    {
                      "font-weight": "500"
                    },
                    {
                      "opacity": "0.7"
                    }
                  ],
                  "greeting": [
                    {
                      "justify-self": "start"
                    },
                    {
                      "font-size": "30px"
                    },
                    {
                      "font-weight": "700"
                    },
                    {
                      "letter-spacing": "-0.4px"
                    }
                  ],
                  "status": [
                    {
                      "justify-self": "stretch"
                    },
                    {
                      "text-align": "left"
                    },
                    {
                      "margin-top": "10px"
                    },
                    {
                      "padding": "12px 14px"
                    },
                    {
                      "border-radius": "14px"
                    },
                    {
                      "font-size": "14px"
                    },
                    {
                      "font-weight": "600"
                    },
                    {
                      "background": "[[[ const g = ['cover.jeff_garage_door','cover.jen_garage_door'].some(e => states[e] && states[e].state !== 'closed'); const z = states['sensor.alarm_zones_active']; const zn = z ? Number(z.attributes.active || 0) : 0; return (g || zn > 0) ? 'rgba(255,184,77,0.16)' : (states['input_boolean.guest_mode'] && states['input_boolean.guest_mode'].state === 'on') ? 'rgba(77,163,255,0.16)' : 'rgba(79,209,160,0.16)'; ]]]"
                    },
                    {
                      "color": "[[[ const g = ['cover.jeff_garage_door','cover.jen_garage_door'].some(e => states[e] && states[e].state !== 'closed'); const z = states['sensor.alarm_zones_active']; const zn = z ? Number(z.attributes.active || 0) : 0; return (g || zn > 0) ? 'var(--amber-color)' : (states['input_boolean.guest_mode'] && states['input_boolean.guest_mode'].state === 'on') ? 'var(--blue-color)' : 'var(--green-color)'; ]]]"
                    }
                  ]
                }
              }
            }
          },
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Garage",
                  "icon": "mdi:garage-variant"
                },
                {
                  "type": "custom:button-card",
                  "entity": "cover.jeff_garage_door",
                  "name": "Jeff's garage",
                  "icon": "mdi:garage-variant",
                  "tap_action": {
                    "action": "more-info"
                  },
                  "show_state": false,
                  "show_label": false,
                  "custom_fields": {
                    "state": "[[[ return entity.state.charAt(0).toUpperCase() + entity.state.slice(1); ]]]",
                    "sub": "[[[ return 'since ' + new Date(entity.last_changed).toLocaleTimeString([], {hour: 'numeric', minute: '2-digit'}); ]]]",
                    "btn": {
                      "card": {
                        "type": "custom:button-card",
                        "entity": "cover.jeff_garage_door",
                        "name": "[[[ return entity.state === \"closed\" ? \"Open\" : \"Close\"; ]]]",
                        "show_icon": false,
                        "tap_action": {
                          "action": "toggle"
                        },
                        "styles": {
                          "card": [
                            {
                              "height": "48px"
                            },
                            {
                              "border-radius": "14px"
                            },
                            {
                              "box-shadow": "none"
                            },
                            {
                              "background": "rgba(127,127,127,0.18)"
                            }
                          ],
                          "name": [
                            {
                              "font-size": "16px"
                            },
                            {
                              "font-weight": "700"
                            }
                          ]
                        }
                      }
                    }
                  },
                  "styles": {
                    "card": [
                      {
                        "border-radius": "22px"
                      },
                      {
                        "padding": "14px"
                      },
                      {
                        "height": "100%"
                      }
                    ],
                    "grid": [
                      {
                        "grid-template-areas": "\"i n\" \"state state\" \"sub sub\" \"btn btn\""
                      },
                      {
                        "grid-template-columns": "40px 1fr"
                      },
                      {
                        "grid-template-rows": "auto auto auto auto"
                      },
                      {
                        "row-gap": "6px"
                      }
                    ],
                    "icon": [
                      {
                        "width": "28px"
                      }
                    ],
                    "name": [
                      {
                        "justify-self": "start"
                      },
                      {
                        "font-size": "14px"
                      },
                      {
                        "opacity": "0.7"
                      }
                    ],
                    "custom_fields": {
                      "state": [
                        {
                          "justify-self": "start"
                        },
                        {
                          "font-size": "30px"
                        },
                        {
                          "font-weight": "700"
                        },
                        {
                          "color": "[[[ return entity.state === 'closed' ? 'var(--primary-text-color)' : 'var(--amber-color)'; ]]]"
                        }
                      ],
                      "sub": [
                        {
                          "justify-self": "start"
                        },
                        {
                          "font-size": "13px"
                        },
                        {
                          "opacity": "0.7"
                        }
                      ],
                      "btn": [
                        {
                          "width": "100%"
                        },
                        {
                          "margin-top": "6px"
                        }
                      ]
                    }
                  },
                  "grid_options": {
                    "columns": 6
                  }
                },
                {
                  "type": "custom:button-card",
                  "entity": "cover.jen_garage_door",
                  "name": "Jen's garage",
                  "icon": "mdi:garage-variant",
                  "tap_action": {
                    "action": "more-info"
                  },
                  "show_state": false,
                  "show_label": false,
                  "custom_fields": {
                    "state": "[[[ return entity.state.charAt(0).toUpperCase() + entity.state.slice(1); ]]]",
                    "sub": "[[[ return 'since ' + new Date(entity.last_changed).toLocaleTimeString([], {hour: 'numeric', minute: '2-digit'}); ]]]",
                    "btn": {
                      "card": {
                        "type": "custom:button-card",
                        "entity": "cover.jen_garage_door",
                        "name": "[[[ return entity.state === \"closed\" ? \"Open\" : \"Close\"; ]]]",
                        "show_icon": false,
                        "tap_action": {
                          "action": "toggle"
                        },
                        "styles": {
                          "card": [
                            {
                              "height": "48px"
                            },
                            {
                              "border-radius": "14px"
                            },
                            {
                              "box-shadow": "none"
                            },
                            {
                              "background": "rgba(127,127,127,0.18)"
                            }
                          ],
                          "name": [
                            {
                              "font-size": "16px"
                            },
                            {
                              "font-weight": "700"
                            }
                          ]
                        }
                      }
                    }
                  },
                  "styles": {
                    "card": [
                      {
                        "border-radius": "22px"
                      },
                      {
                        "padding": "14px"
                      },
                      {
                        "height": "100%"
                      }
                    ],
                    "grid": [
                      {
                        "grid-template-areas": "\"i n\" \"state state\" \"sub sub\" \"btn btn\""
                      },
                      {
                        "grid-template-columns": "40px 1fr"
                      },
                      {
                        "grid-template-rows": "auto auto auto auto"
                      },
                      {
                        "row-gap": "6px"
                      }
                    ],
                    "icon": [
                      {
                        "width": "28px"
                      }
                    ],
                    "name": [
                      {
                        "justify-self": "start"
                      },
                      {
                        "font-size": "14px"
                      },
                      {
                        "opacity": "0.7"
                      }
                    ],
                    "custom_fields": {
                      "state": [
                        {
                          "justify-self": "start"
                        },
                        {
                          "font-size": "30px"
                        },
                        {
                          "font-weight": "700"
                        },
                        {
                          "color": "[[[ return entity.state === 'closed' ? 'var(--primary-text-color)' : 'var(--amber-color)'; ]]]"
                        }
                      ],
                      "sub": [
                        {
                          "justify-self": "start"
                        },
                        {
                          "font-size": "13px"
