      "button_card_templates": {
        "zone": {
          "show_name": true,
          "show_icon": true,
          "show_state": false,
          "show_label": true,
          "name": "[[[ return variables.label; ]]]",
          "label": "[[[ const s = entity; const dc = s.attributes.device_class; const on = s.state === 'on'; const t = dc === 'motion' ? (on ? 'Motion' : 'Clear') : (on ? 'Open' : 'Closed'); const au = states[variables.automation]; const ae = au && au.state === 'on'; return t + ' · <span style=\"font-weight:600;color:' + (ae ? 'var(--green-color)' : 'var(--secondary-text-color)') + '\">Alert ' + (ae ? 'on' : 'off') + '</span>'; ]]]",
          "icon_tap_action": {
            "action": "more-info"
          },
          "styles": {
            "card": [
              {
                "border-radius": "18px"
              },
              {
                "padding": "8px 12px"
              },
              {
                "height": "60px"
              },
              {
                "background": "[[[ return entity.state === 'on' ? 'rgba(255,184,77,0.16)' : 'var(--card-background-color)'; ]]]"
              }
            ],
            "grid": [
              {
                "grid-template-areas": "\"i n\" \"i l\""
              },
              {
                "grid-template-columns": "36px 1fr"
              },
              {
                "grid-template-rows": "auto auto"
              },
              {
                "column-gap": "10px"
              }
            ],
            "icon": [
              {
                "width": "26px"
              },
              {
                "color": "[[[ return entity.state === 'on' ? 'var(--amber-color)' : 'var(--secondary-text-color)'; ]]]"
              }
            ],
            "name": [
              {
                "justify-self": "start"
              },
              {
                "font-size": "15px"
              },
              {
                "font-weight": "600"
              }
            ],
            "label": [
              {
                "justify-self": "start"
              },
              {
                "font-size": "12px"
              }
            ]
          }
        }
      }
    }
  }
}